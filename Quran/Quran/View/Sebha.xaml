<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             x:Class="Quran.Sebha"
                    BackgroundColor="#3B4077"
               xmlns:local="clr-namespace:Quran;assembly=Quran"
             >
    <ContentPage.ToolbarItems BarBackgroundColor="0E8192" >
        <ToolbarItem  Text="االمسبحة" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content >
        <StackLayout>
            <AbsoluteLayout>

                <Grid AbsoluteLayout.LayoutBounds="0,0,1,0.5" AbsoluteLayout.LayoutFlags="All">
                    <Image Source="Sabhabackground.png" Aspect="AspectFill" />
                    <Grid VerticalOptions="CenterAndExpand"  IsVisible="True" Grid.Row="0"  x:Name="GridImage">
                        <Image Source="Ellipse.png"  HeightRequest="150"  />
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" >
                            <Label Text="0" x:Name="lblTas" TextColor="#CEFF00" FontSize="70"/>
                        </StackLayout>
                    </Grid>
                </Grid>
                <Grid BackgroundColor="#2EA15A" IsVisible="True" Grid.Row="0" AbsoluteLayout.LayoutBounds="0,0,1,0.1" AbsoluteLayout.LayoutFlags="All" Padding="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Text="-- ---- ----" HorizontalOptions="Center" VerticalOptions="Center" x:Name="hijriday" FontSize="12" FontFamily="{StaticResource ArbFONTS2Bold}" TextColor="White" Grid.Row="0" Grid.Column="1"/>
                    <Label Text="-- ---- ----"  x:Name="timeday" HorizontalOptions="Center" VerticalOptions="Center"  FontSize="12" FontFamily="{StaticResource ArbFONTS2Bold}" TextColor="White" Grid.Row="1" Grid.Column="1"/>
                    <Label Text="-- ---- ----"  HorizontalOptions="Center" VerticalOptions="Center" x:Name="enghijriday" FontSize="12" FontFamily="{StaticResource ArbFONTS2Bold}" TextColor="White" Grid.Row="0" Grid.Column="0"/>
                    <Label Text="-- ---- ----" x:Name="engtimeday" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12"  FontFamily="{StaticResource ArbFONTS2Bold}" TextColor="White" Grid.Row="1" Grid.Column="0"/>
                </Grid>
                <Grid Padding="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button   Text="تصفير المسبحة" FontFamily="{StaticResource ArbFONTS1}" x:Name="btnClean" Clicked="btnClean_Clicked" Grid.Row="1" BorderColor="#03A841" BackgroundColor="White" BorderWidth="2" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="250" CornerRadius="20" TextColor="#03A841"/>
                    <CollectionView x:Name="CTasbihlst" Grid.Row="2" VerticalOptions="EndAndExpand" AbsoluteLayout.LayoutBounds="0,0.01,1,0.52" AbsoluteLayout.LayoutFlags="All" SelectionMode="Single" SelectionChanged="CTasbihlst_SelectionChanged">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Text="{Binding Title}" Grid.Row="0" TextColor="{Binding color}" FontFamily="{StaticResource ArbFONTS1}" FontSize="20" Grid.Column="2"/>
                                    <Label Text="{Binding NO}" x:Name="lblNo" Grid.Column="1"  FontFamily="{StaticResource ArbFONTS1}" Grid.Row="0" FontSize="25" TextColor="{Binding color}"/>
                                    <ImageButton  Source="btnDelete.jpg" BackgroundColor="Transparent" Grid.Column="0" x:Name="btnDelete"  HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="20" HeightRequest="20" Grid.Row="0" Clicked="btnDelete_Clicked" CommandParameter="{Binding ID}"/>
                                    <BoxView BackgroundColor="White" Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Grid>

                <Frame BackgroundColor="White"    AbsoluteLayout.LayoutBounds="0.05,0.98,60,60" CornerRadius="40" HasShadow="True"
                       AbsoluteLayout.LayoutFlags="PositionProportional">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btnDeleteAll_Clicked" NumberOfTapsRequired="1"/>
                    </Frame.GestureRecognizers>
                    <ImageButton  Source="btnDelete.jpg" BackgroundColor="Transparent"  x:Name="btnDeleteAll"  HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="20" HeightRequest="20" Clicked="btnDeleteAll_Clicked" />
                </Frame>
                <Frame BackgroundColor="White"   AbsoluteLayout.LayoutBounds="0.95,0.98,60,60" CornerRadius="40" HasShadow="True"
                       AbsoluteLayout.LayoutFlags="PositionProportional">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btnAdd_Clicked" NumberOfTapsRequired="1"/>
                    </Frame.GestureRecognizers>
                    <ImageButton  Source="addTas.png"  x:Name="btnAdd"  HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="40" HeightRequest="40" Clicked="btnAdd_Clicked" />
                </Frame>
            </AbsoluteLayout>
            <local:AdBanner HeightRequest="62" BackgroundColor="White" Size="Standardbanner" VerticalOptions="EndAndExpand"/>
        </StackLayout>
       

    </ContentPage.Content>
</ContentPage>
